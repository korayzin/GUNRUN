  - {fileID: 8300000, guid: ea0fa599895d50a4487e5bc663b05511, type: 3}
  - {fileID: 8300000, guid: 6076f09db48f9a947a96020094c7521d, type: 3}
  - {fileID: 8300000, guid: bc5cc834ebf4b5c43a85d6e08f4f2a29, type: 3}
  - {fileID: 8300000, guid: a80cab322bea6bb4998c9d93ab8e600a, type: 3}
  - {fileID: 8300000, guid: 2d728902b902b4248bb0fabb4f2432de, type: 3}
  holographicHUDText: "All weapons are unlocked. You can play with any weapon you
    want using the left joystick! \r\n"
  holographicHUDSFX: {fileID: 8300000, guid: 669e6a3df8db3144099f013202a9cb88, type: 3}
  holographicHUDDuration: 5
  finalPhaseText: The tutorial is over. Now it's time for battle. Good luck!
  finalPhaseSFX: {fileID: 8300000, guid: 7b55e71868559bb49b6502d71608cf1f, type: 3}
