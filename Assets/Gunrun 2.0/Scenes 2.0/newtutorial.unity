  botDissolveSpawnDuration: 0.5
  botDissolveDespawnDuration: 0.4
  destructiblePhaseDuration: 5
  destructibleText: 'Hey! Welcome. Let''s start by breaking this reality. Use your
    guns to destroy these walls! '
  destructibleVoiceClip: {fileID: 8300000, guid: 86216f3e66bfc03459583830d29e573d,
    type: 3}
  destructibleSFX: {fileID: 0}
  enemyStopAfterSeconds: 5
  enemySpeed: 7
  typingSpeedPerChar: 0.02
  dialogueEndBuffer: 1
  weaponIntroText:
  - Kill the enemies coming towards you from the portals!
  - 'The weapon has been replaced with a more powerful one. Now test it. '
  - 'Now you have a weapon with fewer bullets but greater range. Go on, kill the
    enemies! '
  - The weapon has changed! You know what to do. Fire!
  - Dual-wield weapons unlocked! Hold down A button and fire your new gun!
  - Now You have a slowdown gun in your left hand. Use it to slow down the enemies.
    And kill them by your right hand!
  - The weapon has changed! Press A to activate the whip, and enemies will retreat.
  - You now have a helper-guy. Press A to activate them to kill enemies before you
    do.
  - Fire the last weapon! Press A to throw a fireball!
  weaponIntroSFX:
  - {fileID: 8300000, guid: e2e0b63b28d75984db8ffb76ae873157, type: 3}
